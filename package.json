{
  "name": "task-gantt-app",
  "private": true,
  "version": "0.4.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib middleware.ts",
    "prisma:generate": "node scripts/generate-client.cjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:admin": "tsx --env-file-if-exists=.env scripts/admin.ts",
    "db:init": "tsx --env-file-if-exists=.env scripts/init-db.ts",
    "test:e2e": "playwright test",
    "db:upgrade": "tsx --env-file-if-exists=.env scripts/migrate-workspace.ts",
    "check:workspace": "node --check public/workspace/app.js && node --check public/workspace/office-worker.js && node --check public/workspace/task-filter.js && node --check public/workspace/product-ui.js && node --check public/workspace/mentions.js && node --check public/workspace/card-tools.js && node --check public/workspace/card-tree.js"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^6.19.2",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "jose": "^5.6.3",
    "lucide-react": "^0.563.0",
    "next": "^15.5.28",
    "pdfkit": "^0.17.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@prisma/internals": "^6.19.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.12",
    "@types/pdfkit": "^0.17.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.4.41",
    "prettier": "^3.9.10",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "overrides": {
    "@prisma/adapter-better-sqlite3": {
      "better-sqlite3": "12.11.1"
    }
  }
}
