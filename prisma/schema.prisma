generator client {
  provider = "prisma-client-js"
  engineType = "client"
  output = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(uuid())
  name             String
  email            String        @unique
  passwordHash     String
  role             String        @default("USER")
  createdAt        DateTime      @default(now())
  ownedTasks       Task[]        @relation("Owner")
  responsibleTasks Task[]        @relation("Responsible")
  executingTasks   Task[]        @relation("Executor")
  comments         TaskComment[]
}

model Task {
  id              String        @id @default(uuid())
  title           String
  description     String?
  startDate       DateTime
  endDate         DateTime
  percentComplete Int           @default(0)
  status          String        @default("PLANNED")
  priority        String        @default("MEDIUM")
  tags            String?
  executorName    String?
  responsibleName String?
  executorId      String?
  responsibleId   String?
  parentTaskId    String?
  ownerId         String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  owner           User?         @relation("Owner", fields: [ownerId], references: [id])
  parentTask      Task?         @relation("TaskParent", fields: [parentTaskId], references: [id])
  subtasks        Task[]        @relation("TaskParent")
  responsible     User?         @relation("Responsible", fields: [responsibleId], references: [id])
  executor        User?         @relation("Executor", fields: [executorId], references: [id])
  comments        TaskComment[]
  attachments     Attachment[]
  projectId String?
  responsibleContactId String?
  kind String @default("task")
  startTime String?
  endTime String?
  location String?
  timeZone String @default("Asia/Jerusalem")
  legacyTags String?
  legacyAssignments String?
  creationFingerprint String?
  revision Int @default(0)
  project Project? @relation(fields:[projectId],references:[id],onDelete:SetNull)
  responsibleContact Contact? @relation("ContactResponsible",fields:[responsibleContactId],references:[id],onDelete:SetNull)
  taskExecutors TaskExecutor[]
  @@index([projectId])
  @@index([responsibleContactId])

  @@index([startDate])
  @@index([endDate])
  @@index([executorId])
  @@index([responsibleId])
  @@index([parentTaskId])
  @@index([executorName])
  @@index([responsibleName])
  @@index([ownerId])
}

model TaskComment {
  id        String   @id @default(uuid())
  body      String
  createdAt DateTime @default(now())
  taskId    String
  authorId  String
  kind String @default("comment")
  resolved Boolean @default(false)
  revision Int @default(0)
  author    User     @relation(fields: [authorId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([authorId])
}

model NamePolicy {
  id        String   @id @default(uuid())
  scope     String
  field     String
  value     String
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scope, field, value])
}

model Attachment {
  id String @id @default(uuid())
  taskId String
  name String
  type String
  size Int
  data Bytes
  createdAt DateTime @default(now())
  task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
  @@index([taskId])
}

model Project {
 id String @id @default(uuid())
 name String
 key String @unique
 color String @default("#7ba0df")
 archived Boolean @default(false)
 revision Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 tasks Task[]
}
model Contact {
 id String @id @default(uuid())
 name String
 key String @unique
 type String @default("Человек")
 responsible Boolean @default(false)
 archived Boolean @default(false)
 revision Int @default(0)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 executors TaskExecutor[]
 responsibleTasks Task[] @relation("ContactResponsible")
}
model TaskExecutor {
 taskId String
 contactId String
 task Task @relation(fields:[taskId],references:[id],onDelete:Cascade)
 contact Contact @relation(fields:[contactId],references:[id],onDelete:Cascade)
 @@id([taskId,contactId])
 @@index([contactId])
}
model WorkspaceMeta {
 key String @id
 value String
}
